NODE_ENV=development
PORT=3001
# Copy the SQL connection endpoint from the Fabric Warehouse settings.
# Use only the hostname here (no tcp:, protocol, port, or database name).
FABRIC_SQL_SERVER=replace-with-endpoint.datawarehouse.fabric.microsoft.com
# This is the Warehouse item/database name shown by Fabric.
FABRIC_SQL_DATABASE=BigStarWarehouse
FABRIC_SQL_PORT=1433
FABRIC_SQL_ENCRYPT=true
FABRIC_SQL_TRUST_SERVER_CERTIFICATE=false

# Microsoft Entra service principal used by the unattended API server.
AZURE_TENANT_ID=replace-with-directory-tenant-id
AZURE_CLIENT_ID=replace-with-application-client-id
AZURE_CLIENT_SECRET=replace-with-client-secret

DB_POOL_MAX=10
DB_SCHEMA=dbo
DB_TRANSACTION_RETRIES=3
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:3000

# Configure this to the known reverse-proxy hop count or subnet when deployed
# behind a proxy so rate limiting sees the real client IP.
TRUST_PROXY=false

# Required only by `npm run maintenance:create-admin`.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-unique-password
# ADMIN_NAME=Operations Administrator
# ADMIN_ROLE=ELT

# Optional alternatives to `--file` for the archived workbook migrations.
# IMPORT_WORKBOOK_PATH=<absolute-path-to-client-export.xlsm>
# SOURCE_WORKBOOK_PATH=<absolute-path-to-source-report.xlsm>
